DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

DATABASE_URL=

# Backblaze B2 (video storage)
# https://secure.backblaze.com/b2_buckets.htm
B2_KEY_ID=
B2_APPLICATION_KEY=
B2_BUCKET_NAME=away-videos
B2_REGION=us-west-004
B2_ENDPOINT_URL=https://s3.us-west-004.backblazeb2.com
# Optional: public base from bucket settings, e.g.
# https://f004.backblazeb2.com/file/away-videos
# B2_PUBLIC_BASE_URL=

SNIPPE_MOCK=true
SNIPPE_BASE_URL=https://api.snippe.sh
SNIPPE_API_KEY=
SNIPPE_WEBHOOK_URL=
