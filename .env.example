DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
# DJANGO_CSRF_TRUSTED_ORIGINS=https://your-app.onrender.com

# Neon Postgres
DATABASE_URL=

# Bunny.net Storage + CDN (required on Render so videos survive redeploy)
# 1. Create Storage Zone: https://dash.bunny.net/storage
# 2. Storage zone name → BUNNY_STORAGE_ZONE
# 3. FTP & API Access → Password → BUNNY_STORAGE_API_KEY
# 4. Create Pull Zone linked to that storage → Hostname → BUNNY_CDN_HOSTNAME
#    Example: away-videos.b-cdn.net
BUNNY_STORAGE_ZONE=
BUNNY_STORAGE_API_KEY=
BUNNY_CDN_HOSTNAME=
# Optional: region host (default Frankfurt)
# BUNNY_STORAGE_HOST=storage.bunnycdn.com
# uk.storage.bunnycdn.com | ny.storage.bunnycdn.com | sg.storage.bunnycdn.com

# Snippe
SNIPPE_MOCK=true
SNIPPE_BASE_URL=https://api.snippe.sh
SNIPPE_API_KEY=
SNIPPE_WEBHOOK_URL=
