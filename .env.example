DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
# DJANGO_CSRF_TRUSTED_ORIGINS=https://your-app.onrender.com

# Neon Postgres
DATABASE_URL=

# Cloudinary — REQUIRED on Render so videos survive redeploy
# Free account: https://cloudinary.com/users/register/free
# Dashboard → API Keys → copy "API Environment variable"
# Example: cloudinary://123456789012345:abcdef_secret@your_cloud_name
CLOUDINARY_URL=

# Snippe
SNIPPE_MOCK=true
SNIPPE_BASE_URL=https://api.snippe.sh
SNIPPE_API_KEY=
SNIPPE_WEBHOOK_URL=
