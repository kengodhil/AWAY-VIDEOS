DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
# DJANGO_CSRF_TRUSTED_ORIGINS=https://your-app.onrender.com

DATABASE_URL=

# Bunny Stream (required on Render)
# dash.bunny.net → Stream → your library
# Library ID → BUNNY_STREAM_LIBRARY_ID
# API → API key → BUNNY_STREAM_API_KEY
# Pull zone hostname e.g. vz-xxxxx.b-cdn.net → BUNNY_STREAM_CDN_HOSTNAME
BUNNY_STREAM_LIBRARY_ID=
BUNNY_STREAM_API_KEY=
BUNNY_STREAM_CDN_HOSTNAME=

SNIPPE_MOCK=true
SNIPPE_BASE_URL=https://api.snippe.sh
SNIPPE_API_KEY=
SNIPPE_WEBHOOK_URL=
