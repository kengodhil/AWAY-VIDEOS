DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

DATABASE_URL=

# Bunny Storage + Pull Zone CDN (instant MP4 play, no Stream encoding)
# 1. dash.bunny.net → Storage → create zone → name = BUNNY_STORAGE_ZONE
# 2. FTP & API Access → Password = BUNNY_STORAGE_API_KEY
# 3. CDN → Pull Zone linked to storage → Hostname = BUNNY_CDN_HOSTNAME
BUNNY_STORAGE_ZONE=
BUNNY_STORAGE_API_KEY=
BUNNY_CDN_HOSTNAME=
# Optional region host (default Frankfurt):
# BUNNY_STORAGE_HOST=storage.bunnycdn.com

SNIPPE_MOCK=true
SNIPPE_BASE_URL=https://api.snippe.sh
SNIPPE_API_KEY=
SNIPPE_WEBHOOK_URL=
