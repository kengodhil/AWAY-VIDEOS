DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
# For production / Render:
# DJANGO_CSRF_TRUSTED_ORIGINS=https://your-app.onrender.com

# Snippe (https://snippe.sh) — set SNIPPE_MOCK=false with a real key
SNIPPE_MOCK=true
SNIPPE_BASE_URL=https://api.snippe.sh
SNIPPE_API_KEY=
# Public HTTPS webhook, e.g. https://yourdomain.com/webhooks/snippe/
SNIPPE_WEBHOOK_URL=
