DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
# DJANGO_CSRF_TRUSTED_ORIGINS=https://your-app.onrender.com

# Neon Postgres
DATABASE_URL=

# Cloudinary CDN — REQUIRED on Render so videos survive redeploy
# Free: https://cloudinary.com/users/register/free
# Dashboard → Settings → API Keys → copy "API Environment variable"
# Format: cloudinary://API_KEY:API_SECRET@CLOUD_NAME
CLOUDINARY_URL=

# Optional CDN extras (usually leave unset)
# CLOUDINARY_PRIVATE_CDN=false
# CLOUDINARY_SECURE_DISTRIBUTION=your-cname.example.com

# Snippe
SNIPPE_MOCK=true
SNIPPE_BASE_URL=https://api.snippe.sh
SNIPPE_API_KEY=
SNIPPE_WEBHOOK_URL=
