DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
# For production / Render:
# DJANGO_CSRF_TRUSTED_ORIGINS=https://your-app.onrender.com

# Neon Postgres (leave empty for local SQLite)
# Copy the connection string from Neon console → Connection details → URI
# Example:
# DATABASE_URL=postgresql://user:password@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# Snippe (https://snippe.sh) — set SNIPPE_MOCK=false with a real key
SNIPPE_MOCK=true
SNIPPE_BASE_URL=https://api.snippe.sh
SNIPPE_API_KEY=
SNIPPE_WEBHOOK_URL=
