DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
# For production / Render also set:
# DJANGO_CSRF_TRUSTED_ORIGINS=https://your-app.onrender.com

# Set to false when you have live Selcom credentials
SELCOM_MOCK=true
SELCOM_BASE_URL=https://apigw.selcommobile.com
SELCOM_API_KEY=
SELCOM_API_SECRET=
SELCOM_VENDOR=
# Public HTTPS URL Selcom can call, e.g. https://yourdomain.com/webhooks/selcom/
SELCOM_WEBHOOK_URL=
